{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Status",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}",
			"args": [
				"--status",
				"-config",
				"${workspaceFolder}/config.json"
			]
		},
		{
			"name": "Backup",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}",
			"args": [
				"--backup",
				"-verbose",
				"-config",
				"${workspaceFolder}/config.json"
			]
		},
		{
			"name": "Backup wie Aufgabenplanung (UNC-Pfade)",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}",
			"args": [
				"--backup",
				"-verbose",
				"-config",
				"\\\\elisa\\daten\\Jans Dateien\\Dokumente\\Development\\go\\MySqlBackup\\config.json"
			],
			"cwd": "\\\\elisa\\daten\\Jans Dateien\\Dokumente\\Development\\go\\MySqlBackup",
			"console": "integratedTerminal"
		},
		{
			"name": "Getfile (mysql_backup_20260202_NOAH_myplan.zip)",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}",
			"args": [
				"--getfile",
				"mysql_backup_20260202_NOAH_myplan.zip",
				"-config",
				"${workspaceFolder}/config.json"
			],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Datenbank voll wiederherstellen (restorefull)",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}",
			"args": [
				"-restorefull",
				"-config",
				"${workspaceFolder}/config.json"
			],
			"cwd": "${workspaceFolder}"
		}
	]
}
